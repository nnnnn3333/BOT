# Токен от @BotFather
BOT_TOKEN=123456789:replace_me

# Ваш числовой Telegram ID (узнать: @userinfobot). Все остальные пользователи игнорируются.
ADMIN_ID=YOUR_TELEGRAM_ID

# Часовой пояс для имён папок YYYY-MM, отчётов и расписания бэкапа
TIMEZONE=Europe/Kaliningrad

# Время ежесуточного бэкапа (HH:MM, в часовом поясе выше)
BACKUP_TIME=03:00

# Необязательно (относительные пути считаются от папки проекта):
# DB_PATH=work_base.db
# STORAGE_DIR=storage
# TMP_DIR=tmp
# MAX_CONTENT_CHARS=1000000
